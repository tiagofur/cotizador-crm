generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TABLERO | CUBIERTA
model Material {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String   @default("TABLERO")
  costPerM2      Float?
  costPerMl      Float?
  edgeBandCostMl Float?
  edgeBandName   String?
  sheetWidth     Float?
  sheetLength    Float?
  sheetCost      Float?
  thickness      String?
  notes          String?
  isMaderado     Boolean  @default(false)
  active         Boolean  @default(true)
  pieces         Piece[]
  settings       Settings[]
  quotations     Quotation[]
  maquilaLines   MaquilaLine[]
  maquilaPieces  MaquilaPiece[]
  bodyProfiles   FinishProfile[] @relation("FinishProfileBody")
  frontProfiles  FinishProfile[] @relation("FinishProfileFront")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Hardware {
  id             String   @id @default(cuid())
  name           String   @unique
  unit           String   @default("Pieza")
  unitCost       Float
  notes          String?
  active         Boolean  @default(true)
  furnitureItems FurnitureHardware[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Furniture {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  category          String   @default("Otro")
  width             Float    @default(0)
  height            Float    @default(0)
  depth             Float    @default(0)
  imageUrl          String?
  notes             String?
  appliesCountertop Boolean  @default(false)
  countertopWidthM  Float    @default(0)
  order             Int      @default(0)
  pieces            Piece[]
  hardwareItems     FurnitureHardware[]
  quotationItems    QuotationItem[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Piece {
  id          String    @id @default(cuid())
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  qty         Int       @default(1)
  length      Float
  width       Float
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  grain       Boolean   @default(false)
  isFront     Boolean   @default(false)
  bandLong1   Boolean   @default(false)
  bandLong2   Boolean   @default(false)
  bandShort1  Boolean   @default(false)
  bandShort2  Boolean   @default(false)
  order       Int       @default(0)
}

model FurnitureHardware {
  id          String    @id @default(cuid())
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  hardwareId  String
  hardware    Hardware  @relation(fields: [hardwareId], references: [id], onDelete: Cascade)
  qty         Int       @default(1)

  @@unique([furnitureId, hardwareId])
}

model Settings {
  id                  String    @id @default("default")
  companyName         String    @default("Nahú Cocinas")
  companyPhone        String?   @default("322 349 2746")
  companyEmail        String?   @default("nahucocinas@gmail.com")
  companyAddress      String?   @default("Boca de Tomates 233, Las Juntas · 48291 Puerto Vallarta, Jal.")
  saleFactor          Float     @default(6.7)
  ivaRate             Float     @default(0.16)
  distributorDiscount Float     @default(0.35)
  laborPerUnit        Float     @default(0)
  countertopMultipleM Float     @default(1.2)
  countertopFactor    Float     @default(4)
  currency            String    @default("MXN")
  stalledThresholdDays Int      @default(21)
  wasteFactorStandard Float     @default(1.0)
  wasteFactorMaderado Float     @default(1.0)
  maderadoMaterialId  String?
  maderadoMaterial    Material? @relation(fields: [maderadoMaterialId], references: [id])
  // Tarifario de maquila: corte por pasada de sierra y encintado por ml (servicio, aparte del material)
  cutCostPerPass        Float   @default(15)
  edgeBandServiceCostMl Float   @default(12)
  // Plazos de entrega estimada en documentos nuevos (días naturales, editables por documento)
  deliveryDaysCocina    Int     @default(30)
  deliveryDaysMaquila   Int     @default(7)
  // Portal: pasadas de sierra promedio por tablero para pre-cotizar solicitudes sin despiece
  avgCutsPerSheet       Float   @default(25)
}

// Perfil de acabado: define qué materiales usa el cuerpo y los frentes.
// ids 'BLANCO' y 'MADERADO' son los acabados históricos; el resto son colores de frente.
model FinishProfile {
  id               String   @id
  name             String
  usePieceMaterials Boolean @default(false) // true (Blanco): cada pieza usa su material del despiece
  bodyMaterialId   String?
  bodyMaterial     Material? @relation("FinishProfileBody", fields: [bodyMaterialId], references: [id])
  frontMaterialId  String?
  frontMaterial    Material? @relation("FinishProfileFront", fields: [frontMaterialId], references: [id])
  active           Boolean  @default(true)
  order            Int      @default(0)
}

model Client {
  id             String        @id @default(cuid())
  name           String  // Razon social o nombre de contacto
  kind           String        @default("PROSPECTO")  // CARPINTERO | DISTRIBUIDOR | FABRICA | PROSPECTO | OTRO
  stage          String        @default("PROSPECTANDO")  // NUEVO | PROSPECTANDO | CONTACTADO | COTIZADO | NEGOCIACION | GANADO | PERDIDO
  company        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  notes          String?
  /// Descuento % propio (0-100). Null = usar el descuento base de Configuración
  discountPercent Float?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  quotations     Quotation[]
  interactions   Interaction[]
  /// Cuenta del portal del cliente (1:1; solo para clientes con acceso al portal)
  portalUser     User?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Usuarios de la app interna (ADMIN | TIENDA) y del portal (CLIENTE). Mono-empresa: sin tenant.
model User {
  id           String   @id @default(cuid())
  /// Login interno; opcional para cuentas CLIENTE (login por teléfono)
  email        String?  @unique
  /// Login de clientes del portal, normalizado a solo dígitos (teléfono de la ficha CRM)
  phone        String?  @unique
  name         String
  passwordHash String
  role         String   @default("TIENDA") // ADMIN | TIENDA | CLIENTE
  active       Boolean  @default(true)
  /// Solo CLIENTE: vínculo 1:1 con la ficha CRM; sus cotizaciones se filtran por clientId
  clientId     String?  @unique
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Interaction {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String   @default("NOTA")  // LLAMADA | WHATSAPP | EMAIL | VISITA | COTIZACION | NOTA
  subject     String?
  content     String
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Quotation {
  id                   String     @id @default(cuid())
  folio                String     @unique
  /// Tipo de documento: MUEBLE (cocina armada) | MAQUILA (servicio a carpinteros)
  kind                 String     @default("MUEBLE")
  /// Origen: TIENDA (app interna) | PORTAL (solicitud del cliente)
  source               String     @default("TIENDA")
  clientId             String?
  client               Client?    @relation(fields: [clientId], references: [id])
  clientName           String
  clientPhone          String?
  clientEmail          String?
  title                String?
  orderCode            String?    @unique
  notes                String?
  finish               String     @default("BLANCO")
  countertopMaterialId String?
  countertopMaterial   Material?  @relation(fields: [countertopMaterialId], references: [id])
  applyDistributor     Boolean    @default(false)
  countertopMlOverride Float?
  factorSnapshot       Float      @default(6.7)
  laborSnapshot        Float      @default(0)
  distributorSnapshot  Float?
  /// Revisión actual del documento (pedidos incrementan al editarse)
  rev                  Int        @default(1)
  revisions            QuotationRevision[]
  status               String     @default("BORRADOR")
  furnitureCost        Float      @default(0)
  furnitureSale        Float      @default(0)
  countertopMl         Float      @default(0)
  countertopCost       Float      @default(0)
  countertopSale       Float      @default(0)
  ivaAmount            Float      @default(0)
  totalWithIva         Float      @default(0)
  distributorFurniture Float      @default(0)
  distributorCountertop Float     @default(0)
  distributorIva       Float      @default(0)
  distributorTotal     Float      @default(0)
  // ----- Resumen maquila (0 en documentos MUEBLE) -----
  /// Pasadas de sierra capturadas en el apartado de servicios
  cutQty               Int        @default(0)
  /// true = cutQty es estimado (Σ hojas × promedio); la tienda lo reemplaza por pasadas reales
  cutsEstimated        Boolean    @default(false)
  /// true = hojas por material derivadas del despiece; la tienda las ajusta tras optimizar en máquina
  sheetsEstimated      Boolean    @default(false)
  /// Snapshot $/pasada al cotizar
  cutUnitCost          Float      @default(0)
  /// Σ metros de cintilla de todas las líneas (base del encintado)
  edgeBandMl           Float      @default(0)
  /// Snapshot $/ml del servicio de encintado
  edgeBandUnitCost     Float      @default(0)
  materialsTotal       Float      @default(0)
  servicesTotal        Float      @default(0)
  /// Fecha estimada de entrega (default por tipo: 7 días maquila / 30 cocinas; editable por documento)
  estimatedDeliveryAt  DateTime?
  items                QuotationItem[]
  maquilaLines         MaquilaLine[]
  maquilaPieces        MaquilaPiece[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

// Bitácora de revisiones: snapshot del estado anterior al editar un pedido
model QuotationRevision {
  id               String    @id @default(cuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rev              Int
  status           String
  itemsJson        String
  furnitureSale    Float
  totalWithIva     Float
  distributorTotal Float?
  /// Maquila: importes del snapshot anterior (null en MUEBLE)
  materialsTotal   Float?
  servicesTotal    Float?
  note             String?
  createdAt        DateTime  @default(now())

  @@unique([quotationId, rev])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  furnitureId String?
  furniture   Furniture? @relation(fields: [furnitureId], references: [id])
  qty         Int       @default(1)
  code        String
  name        String
  width       Float     @default(0)
  height      Float     @default(0)
  depth       Float     @default(0)
  unitCost    Float     @default(0)
  unitPrice   Float     @default(0)
}

// Línea de material de una cotización de maquila: tableros completos + cintilla
model MaquilaLine {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  materialId     String
  material       Material  @relation(fields: [materialId], references: [id])
  /// Cantidad de tableros completos (se venden al costo de hoja)
  sheetsQty      Int       @default(0)
  /// Metros de cintilla de esta línea
  edgeBandMl     Float     @default(0)
  /// Snapshot costo de hoja al cotizar
  unitSheetCost  Float     @default(0)
  /// Snapshot costo de cintilla/ml (material) al cotizar
  unitBandCostMl Float     @default(0)
  notes          String?
  order          Int       @default(0)
}

// Pieza del despiece de maquila: el cliente la registra y el sistema estima hojas/cortes.
// Cantos: L1/L2 = lados LARGOS, A1/A2 = lados ANCHOS (encintado por lado)
model MaquilaPiece {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  qty         Int       @default(1)
  /// Largo en mm
  length      Float
  /// Ancho en mm
  width       Float
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])
  /// Veta (orientación de la textura) para el optimizador
  grain       Boolean   @default(false)
  /// Canto en el lado largo 1
  bandL1      Boolean   @default(false)
  /// Canto en el lado largo 2
  bandL2      Boolean   @default(false)
  /// Canto en el lado ancho 1
  bandA1      Boolean   @default(false)
  /// Canto en el lado ancho 2
  bandA2      Boolean   @default(false)
  notes       String?
  order       Int       @default(0)
}
